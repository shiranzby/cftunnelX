cftunnelX
cftunnelX.exe
*.exe
dist/
desktop-client/build/
desktop-client/frontend/dist/
desktop-client/frontend/node_modules/

# Local data（锚定到仓库根目录）
# 注意：这里的 config/ 与 log/ 必须带前导斜杠。写成 `config/` 会匹配任意层级的
# 同名目录，导致 internal/config/ 下的新文件（例如 config_test.go）被静默忽略。
/config/
/log/
*.log
/config.yml
credentials*.json

# Dependencies
vendor/

# 内嵌 cloudflared 资源（由 scripts/fetch-cloudflared.sh 按需生成，不入库）
internal/daemon/assets/*.gz

# Local tooling
.workbuddy/
.claude/
.idea/
.vscode/
*.swp

# System
.DS_Store

# Archives
*.zip

# Secrets
*.pem
*.key
*.env
.env*

# Local publish mirror
publish/
